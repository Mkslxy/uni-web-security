@baseUrl = http://localhost:8080
@itemId = 1
@basicAuth = dXNlcjpwYXNzd29yZA==

### 1. GET ALL ITEMS (Basic Auth -> expect 200)
GET {{baseUrl}}/api/v1/items
Authorization: Basic {{basicAuth}}

> {%
client.test("1. GET ALL - Status is 200", function() {
    client.assert(response.status === 200, "Response status is not 200");
});
%}

### 2. GET ONE ITEM (Basic Auth -> expect 200)
GET {{baseUrl}}/api/v1/items/{{itemId}}
Authorization: Basic {{basicAuth}}

> {%
client.test("2. GET ONE - Status is 200", function() {
    client.assert(response.status === 200, "Response status is not 200");
});
%}

### 3. CREATE ONE ITEM (Basic Auth -> expect 200)
POST {{baseUrl}}/api/v1/items
Content-Type: application/json
Authorization: Basic {{basicAuth}}

{
  "id": "4",
  "name": "name4",
  "description": "description4"
}

> {%
client.test("3. CREATE - Status is 200", function() {
    client.assert(response.status === 200, "Response status is not 200");
});
%}

### 4. UPDATE ONE ITEM (Basic Auth -> expect 200)
PUT {{baseUrl}}/api/v1/items
Content-Type: application/json
Authorization: Basic {{basicAuth}}

{
  "id": "1",
  "name": "name1-updated",
  "description": "description1-updated"
}

> {%
client.test("4. UPDATE - Status is 200", function() {
    client.assert(response.status === 200, "Response status is not 200");
});
%}

### 5. DELETE ONE ITEM (Basic Auth -> expect 200)
DELETE {{baseUrl}}/api/v1/items/4
Authorization: Basic {{basicAuth}}

> {%
client.test("5. DELETE - Status is 200", function() {
    client.assert(response.status === 200, "Response status is not 200");
});
%}

