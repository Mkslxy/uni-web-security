@baseUrl = http://localhost:8080
@itemId = 1

### 1. ADMIN creates an item -> 200 OK
POST {{baseUrl}}/api/v1/items
Content-Type: application/json
Authorization: Basic admin admin

{
  "id": "10",
  "name": "item10",
  "description": "description10"
}

> {%
client.test("1. ADMIN creates item - Status is 200", function() {
    client.assert(response.status === 200, "Response status is not 200");
});
%}

### 2. USER lists items -> 200 OK
GET {{baseUrl}}/api/v1/items
Authorization: Basic user user

> {%
client.test("2. USER lists items - Status is 200", function() {
    client.assert(response.status === 200, "Response status is not 200");
});
%}

### 3. USER reads one item -> 200 OK
GET {{baseUrl}}/api/v1/items/{{itemId}}
Authorization: Basic user user

> {%
client.test("3. USER reads one item - Status is 200", function() {
    client.assert(response.status === 200, "Response status is not 200");
});
%}

### 4. USER tries to create an item -> 403 Forbidden
POST {{baseUrl}}/api/v1/items
Content-Type: application/json
Authorization: Basic user user

{
  "id": "20",
  "name": "item20",
  "description": "forbidden"
}

> {%
client.test("4. USER cannot create item - Status is 403", function() {
    client.assert(response.status === 403, "Response status is not 403");
});
%}

### 5. ADMIN updates an item -> 200 OK
PUT {{baseUrl}}/api/v1/items
Content-Type: application/json
Authorization: Basic admin admin

{
  "id": "10",
  "name": "item10-updated",
  "description": "updated-description"
}

> {%
client.test("5. ADMIN updates item - Status is 200", function() {
    client.assert(response.status === 200, "Response status is not 200");
});
%}

### 6. USER tries to delete an item -> 403 Forbidden
DELETE {{baseUrl}}/api/v1/items/10
Authorization: Basic user user

> {%
client.test("6. USER cannot delete item - Status is 403", function() {
    client.assert(response.status === 403, "Response status is not 403");
});
%}

### 7. ADMIN deletes an item -> 200 OK
DELETE {{baseUrl}}/api/v1/items/10
Authorization: Basic admin admin

> {%
client.test("7. ADMIN deletes item - Status is 200", function() {
    client.assert(response.status === 200, "Response status is not 200");
});
%}

