@baseUrl = http://localhost:8080

### 1. Authenticate as ADMIN -> returns a JWT
POST {{baseUrl}}/api/v1/auth/authenticate
Content-Type: application/json

{
  "username": "admin",
  "password": "admin"
}

> {%
client.test("1. Authenticate as ADMIN - Status is 200 and token present", function() {
    client.assert(response.status === 200, "Expected 200 OK");
    client.assert(response.body.token !== undefined, "Expected JWT token");
});
%}

### 2. Authenticate as USER -> returns a JWT
POST {{baseUrl}}/api/v1/auth/authenticate
Content-Type: application/json

{
  "username": "user",
  "password": "user"
}

> {%
client.test("2. Authenticate as USER - Status is 200 and token present", function() {
    client.assert(response.status === 200, "Expected 200 OK");
    client.assert(response.body.token !== undefined, "Expected JWT token");
});
%}

