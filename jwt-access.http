@baseUrl = http://localhost:8080

### 1. Login as ADMIN -> 200, returns JWT (sub=admin, authorities=ROLE_ADMIN)
# @name loginAdmin
POST {{baseUrl}}/api/v1/auth/authenticate
Content-Type: application/json

{
  "username": "admin",
  "password": "admin"
}

> {% client.global.set("adminToken", response.body.token); %}

###

### 2. Login as USER -> 200, returns JWT (sub=user, authorities=ROLE_USER)
# @name loginUser
POST {{baseUrl}}/api/v1/auth/authenticate
Content-Type: application/json

{
  "username": "user",
  "password": "user"
}

> {% client.global.set("userToken", response.body.token); %}

###

### 3. Login as SUPERADMIN -> 200, returns JWT (sub=superadmin, authorities=ROLE_SUPERADMIN)
# @name loginSuperadmin
POST {{baseUrl}}/api/v1/auth/authenticate
Content-Type: application/json

{
  "username": "superadmin",
  "password": "superadmin"
}

> {% client.global.set("superadminToken", response.body.token); %}

###

### 4. USER Bearer token -> GET /api/v1/items -> 200 (USER/ADMIN allowed)
GET {{baseUrl}}/api/v1/items
Authorization: Bearer {{userToken}}

###

### 5. ADMIN Bearer token -> GET /api/v1/items -> 200 (USER/ADMIN allowed)
GET {{baseUrl}}/api/v1/items
Authorization: Bearer {{adminToken}}

###

### 6. SUPERADMIN Bearer token -> GET /api/v1/items -> 403 (wrong role for this route)
GET {{baseUrl}}/api/v1/items
Authorization: Bearer {{superadminToken}}

###

### 7. No token -> GET /api/v1/items -> 401 (unauthenticated)
GET {{baseUrl}}/api/v1/items

###

### 8. ADMIN Bearer token -> POST /api/v1/items -> 200 (ADMIN-only write)
# @name createItem
POST {{baseUrl}}/api/v1/items
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "id": "10",
  "name": "name10",
  "description": "description10"
}

> {% client.global.set("itemId", response.body.id); %}

###

### 9. USER Bearer token -> POST /api/v1/items -> 403 (USER cannot write)
POST {{baseUrl}}/api/v1/items
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "id": "20",
  "name": "name20",
  "description": "description20"
}

###

### 10. SUPERADMIN Bearer token -> POST /api/v1/items -> 403 (SUPERADMIN cannot write)
POST {{baseUrl}}/api/v1/items
Authorization: Bearer {{superadminToken}}
Content-Type: application/json

{
  "id": "30",
  "name": "name30",
  "description": "description30"
}

###

### 11. ADMIN Bearer token -> PUT /api/v1/items -> 200 (ADMIN-only write)
PUT {{baseUrl}}/api/v1/items
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "id": "10",
  "name": "name10-updated",
  "description": "description10-updated"
}

###

### 12. USER Bearer token -> PUT /api/v1/items -> 403 (USER cannot write)
PUT {{baseUrl}}/api/v1/items
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "id": "10",
  "name": "name10-hacked",
  "description": "description10-hacked"
}

###

### 13. ADMIN Bearer token -> DELETE /api/v1/items/10 -> 200 (ADMIN-only write)
DELETE {{baseUrl}}/api/v1/items/10
Authorization: Bearer {{adminToken}}

###

### 14. USER Bearer token -> DELETE /api/v1/items/1 -> 403 (USER cannot write)
DELETE {{baseUrl}}/api/v1/items/1
Authorization: Bearer {{userToken}}

###

### 15. ADMIN Bearer token -> GET /api/admin/hello -> 200 (ADMIN-only route)
GET {{baseUrl}}/api/admin/hello
Authorization: Bearer {{adminToken}}

###

### 16. USER Bearer token -> GET /api/admin/hello -> 403 (wrong role)
GET {{baseUrl}}/api/admin/hello
Authorization: Bearer {{userToken}}

###

### 17. SUPERADMIN Bearer token -> GET /api/admin/hello -> 403 (wrong role)
GET {{baseUrl}}/api/admin/hello
Authorization: Bearer {{superadminToken}}

###

### 18. SUPERADMIN Bearer token -> GET /api/superadmin/hello -> 200 (SUPERADMIN-only route)
GET {{baseUrl}}/api/superadmin/hello
Authorization: Bearer {{superadminToken}}

###

### 19. ADMIN Bearer token -> GET /api/superadmin/hello -> 403 (wrong role)
GET {{baseUrl}}/api/superadmin/hello
Authorization: Bearer {{adminToken}}

###

### 20. USER Bearer token -> GET /api/superadmin/hello -> 403 (wrong role)
GET {{baseUrl}}/api/superadmin/hello
Authorization: Bearer {{userToken}}
